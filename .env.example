# Backend config. Copy to .env in the repo root.
GEMINI_API_KEY=your_api_key_here
PORT=3000

# Optional. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Optional. Comma-separated frontend origins allowed by CORS, in addition to localhost:3001/3002.
# Defaults to https://aiskillsync.vercel.app
# FRONTEND_URL=https://aiskillsync.vercel.app,https://my-preview.vercel.app
